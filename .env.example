# Environment Variables Template
# Copy this to .env and fill in your values
# Used by pipeline scripts and CI/CD workflows

# ===== MLflow Configuration =====
# Leave as-is for local development (file-based tracking)
# For cloud: set to your MLflow tracking server URI
MLFLOW_TRACKING_URI=file:///home/badr/genomic-variant-mlops/mlruns

# ===== AWS Configuration =====
# Option 1: Use AWS Profile (recommended for local development)
AWS_PROFILE=default
AWS_REGION=us-east-1

# Option 2: Use explicit credentials (use in CI/CD with GitHub Secrets)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ===== Project Configuration =====
PROJECT_ROOT=/home/badr/genomic-variant-mlops
CONFIG_FILE=config/config.yaml
DEBUG_MODE=false

# ===== Pipeline Settings =====
PIPELINE_MODE=training  # Options: training, inference, validation, debug
LOG_LEVEL=INFO           # Options: DEBUG, INFO, WARNING, ERROR
BATCH_SIZE=null          # null = process all at once

# ===== GPU Settings =====
# Automatically detected; override if needed
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0  # Select GPU device (0 = first GPU, RTX 4070)

# ===== Optional: Slack Notifications =====
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===== Optional: GitHub Actions Specific =====
# CI=true  # Set by GitHub Actions automatically
# GITHUB_RUN_ID=  # Set by GitHub Actions automatically
