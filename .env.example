# Copy to .env for local Docker Compose runs.

# Use your host user/group so bind-mounted monitoring files stay writable.
GENOPREDICT_UID=1000
GENOPREDICT_GID=1000

# Grafana dev credentials. Change before sharing a reachable deployment.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-password

# Drift monitor cadence in seconds.
DRIFT_CHECK_INTERVAL_SECONDS=300
