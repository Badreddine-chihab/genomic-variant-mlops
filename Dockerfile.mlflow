FROM python:3.14-slim

WORKDIR /mlflow

# Install system dependencies including curl for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Keep the server aligned with the local MLflow 3 metadata/schema used by training.
RUN pip install --no-cache-dir mlflow==3.10.1

# Create directory for artifacts
RUN mkdir -p /mlflow/mlruns

# Copy entrypoint and registration scripts
COPY entrypoint.sh /entrypoint.sh
COPY src/model/register_model.py /register_model.py
RUN chmod +x /entrypoint.sh

EXPOSE 5000

# Launch MLflow with model registration
ENTRYPOINT ["/entrypoint.sh"]
